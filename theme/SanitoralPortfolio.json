{
  "name": "Sanitoral Portfolio",
  "dataColors": [
    "#0F766E",
    "#94A3B8",
    "#C2410C",
    "#134E4A",
    "#1E293B",
    "#5EEAD4",
    "#CBD5E1",
    "#F59E0B"
  ],
  "foreground": "#1E293B",
  "foregroundNeutralSecondary": "#475569",
  "foregroundNeutralTertiary": "#94A3B8",
  "background": "#FFFFFF",
  "backgroundLight": "#F1F5F9",
  "backgroundNeutral": "#E2E8F0",
  "tableAccent": "#0F766E",
  "good": "#0F766E",
  "neutral": "#94A3B8",
  "bad": "#C2410C",
  "maximum": "#C2410C",
  "center": "#F59E0B",
  "minimum": "#0F766E",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E293B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#475569"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "title": [
          {
            "fontSize": 12,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#1E293B"
              }
            }
          }
        ],
        "subTitle": [
          {
            "fontSize": 9,
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 4,
            "right": 4
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#64748B"
              }
            },
            "textSize": 9,
            "bold": true
          }
        ],
        "items": [
          {
            "textSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1E293B"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontSize": 9,
            "bold": true,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontSize": 9,
            "fontColorPrimary": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "total": [
          {
            "fontSize": 9,
            "bold": true,
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridVertical": false,
            "rowPadding": 3
          }
        ]
      }
    }
  }
}